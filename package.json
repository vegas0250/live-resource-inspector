{
  "name": "live-resource-inspector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Пассивный инспектор сетевых запросов, ссылок и ресурсов текущей вкладки Chrome.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fixtures": "node scripts/serve-fixtures.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "lucide": "^0.545.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vui": "file:../vui"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/chrome": "^0.0.326",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
}
