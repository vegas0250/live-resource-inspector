{
  "manifest_version": 3,
  "name": "Live Resource Inspector",
  "version": "1.0.0",
  "description": "Пассивно собирает URL, домены и ресурсы текущей вкладки. Данные остаются на устройстве.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Live Resource Inspector",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["webRequest", "storage", "tabs", "scripting", "webNavigation", "activeTab"],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*",
    "ws://*/*",
    "wss://*/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
